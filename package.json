{
  "name": "shanten-trainer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest",
    "test:run": "vitest run",
    "fetch-game": "node --env-file=.env --import tsx scripts/fetch-game.ts",
    "list-games": "node --env-file=.env --import tsx scripts/list-games.ts",
    "probe-login": "node --env-file=.env --import tsx scripts/probe-login.ts",
    "debug-auth": "node --env-file=.env --import tsx scripts/debug-auth.ts",
    "debug-route": "node --env-file=.env --import tsx scripts/debug-route.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tsconfig/svelte": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/ws": "^8.18.1",
    "@vitest/ui": "^4.0.16",
    "svelte": "^5.43.8",
    "svelte-check": "^4.3.4",
    "tsx": "^4.23.9",
    "typescript": "~5.9.3",
    "vite": "npm:rolldown-vite@7.2.5",
    "vitest": "^4.0.16"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  },
  "dependencies": {
    "mjsoul": "^2.3.0",
    "protobufjs": "^8.7.1"
  }
}
