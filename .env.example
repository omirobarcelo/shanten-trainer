# Copy to .env and fill in. Do NOT commit .env — it holds credentials.

# Server base URL. Must match the account.
#   EN/US (Yostar): https://mahjongsoul.game.yo-star.com
#   JP:             https://game.mahjongsoul.com
#   CN:             https://game.maj-soul.com
MJSOUL_BASE=https://mahjongsoul.game.yo-star.com

# --- Yostar (EN/US) auth ------------------------------------------------
# Open majsoul in browser, log in. In devtools:
#   Application → Local Storage → mahjongsoul.game.yo-star.com
# Copy both values:
MJSOUL_YOSTAR_TOKEN=
MJSOUL_YOSTAR_UID=

# --- Direct session token (CN/JP only, alternative to Yostar creds) -----
# Log in on browser, then in devtools console:
#   localStorage.getItem('access_token')     # newer
#   GameMgr.Inst.access_token                # older CN client
# Leave blank if using Yostar creds above.
# MJSOUL_ACCESS_TOKEN=

# --- Optional overrides -------------------------------------------------
# Force oauth2 login type. Auto-detected otherwise (Yostar=8, CN/JP=10).
# MJSOUL_LOGIN_TYPE=8
